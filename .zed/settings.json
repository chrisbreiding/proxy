{
  "format_on_save": "on",
  "prettier": {
    "allowed": false,
  },
  "languages": {
    "JavaScript": {
      "formatter": "none",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "formatter": "none",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
  },
}

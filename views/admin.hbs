<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin</title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
  <header>
    <h1>Admin</h1>
    <button type="button" class="link-button" id="logout">Log Out</button>
  </header>
  <h2>Weather Location</h2>
  <section id="weather">
    <p class="weather-current" id="weather-current"></p>
    <div class="weather-controls">
      <button type="button" class="button" id="weather-detect">Use Current Location</button>
      <input type="text" id="weather-latitude" inputmode="decimal" placeholder="Latitude" aria-label="Latitude">
      <input type="text" id="weather-longitude" inputmode="decimal" placeholder="Longitude" aria-label="Longitude">
      <button type="button" class="button" id="weather-set">Set Location</button>
      <button type="button" class="link-button" id="weather-clear">Use Default</button>
      <span id="weather-message"></span>
    </div>
  </section>
  <h2>Jobs</h2>
  <div class="chart" id="chart"></div>
  <div id="jobs"></div>
  <footer>
    <button type="button" id="save" disabled>Save</button>
    <span id="message"></span>
  </footer>
  <script>
    window.weather = {{{weatherJson}}}
    window.jobs = {{{jobsJson}}}
    window.occurrences = {{{occurrencesJson}}}
  </script>
  <script src="/admin.js"></script>
</body>
</html>
